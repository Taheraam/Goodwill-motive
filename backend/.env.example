# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Razorpay Payment Gateway (Optional in Dev - Sandbox Mock Mode active if unset)
