# Copy to backend/.env for local development. Never commit the real .env.

# --- Core ---
# MongoDB must be a replica set (Prisma transactions). Atlas already is one.
# Local (docker compose): mongodb://localhost:27017/goodwillmotive?directConnection=true
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goodwillmotive
# Required, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000

# --- OAuth (leave empty in dev and set ALLOW_OAUTH_SANDBOX=true to use fake users) ---
ALLOW_OAUTH_SANDBOX=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# --- Razorpay (unset in dev = local sandbox; required in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL: https://<api>/api/payments/webhook, events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# --- Mail (unset = emails are logged to the console) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Goodwill Motive <support@goodwillmotive.org>

# --- FAQ assistant (unset = local knowledge-base answers only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Seeding (npm run prisma:seed --workspace=backend) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
