# Mail Service (SMTP) (Optional in Dev - Console Output Fallback active if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Goodwill Motive <support@goodwillmotive.org>

# Gemini AI (Optional - Intelligent Local Knowledge-Base Fallback active if unset)
GEMINI_API_KEY=
